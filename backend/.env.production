# ===========================================
# BASE DE DONNÉES PRODUCTION
# ===========================================
# ⚠️ À REMPLACER par les valeurs de votre base PostgreSQL de production
# (Render, Railway, ou autre service cloud)

DB_NAME=blablabook_prod
DB_USER=votre_user_production
DB_PASSWORD=VOTRE_MOT_DE_PASSE_COMPLEXE_ICI
DB_HOST=votre-serveur-postgres.com
DB_PORT=5432

# ===========================================
# JWT SECRET (Généré de façon sécurisée)
# ===========================================
# ✅ Secret généré automatiquement - NE PAS MODIFIER
JWT_SECRET=c58c06444ce23e3d6cdc6a0ee4cc62f7e1faa88452426f8c5e284ff135a6270b6b91c2225aedc6c0d87bca338e9bad03acf36d9e1ad918ceec8f4dd2feda68f3

# ===========================================
# CONFIGURATION SERVEUR
# ===========================================
PORT=3000
NODE_ENV=production

# ===========================================
# FRONTEND URL
# ===========================================
# ⚠️ À REMPLACER par l'URL de votre frontend en production
# Exemples :
#   - Render : https://blablabook.onrender.com
#   - Domaine personnalisé : https://www.monsite.com
FRONTEND_URL=https://VOTRE-FRONTEND.onrender.com

# ===========================================
# INSTRUCTIONS
